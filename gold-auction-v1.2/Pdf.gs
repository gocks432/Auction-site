/* Google Drive OCR: private temporary Google Doc, trashed after extraction. */
function importPdf_(token,p){var s=withLock_(readState_);auth_(s,token,true);if(typeof p.data!=='string'||p.data.length>7000000)fail_('PDF는 5MB 이하로 올려주세요.');var bytes=Utilities.base64Decode(p.data);if(bytes.length>5000000||bytes.slice(0,5).map(function(x){return String.fromCharCode(x);}).join('')!=='%PDF-')fail_('올바른 PDF 파일이 아닙니다.');var cache=CacheService.getScriptCache(),key='ocr:'+hash_(token,'ocr');if(cache.get(key))fail_('PDF 분석은 30초 간격으로 시도해 주세요.');cache.put(key,'1',30);var id='';try{var blob=Utilities.newBlob(bytes,'application/pdf','student-login.pdf'),doc=Drive.Files.create({name:'임시 로그인 PDF 분석',mimeType:'application/vnd.google-apps.document'},blob,{ocrLanguage:'ko',fields:'id'});id=doc.id;var text=DocumentApp.openById(id).getBody().getText();if(text.length>100000)fail_('PDF 내용이 너무 많습니다. 한 학급 파일로 나누어 주세요.');return {rows:parseLoginText_(text),text:text,warning:'PDF 인식이 완료되었습니다. 번호·아이디·PIN을 원본과 대조하고 확인된 학생만 적용하세요. 표가 비어 있으면 직접 입력하거나 다른 PDF를 선택하세요.'};}catch(e){throw new Error('PDF 분석 실패: '+e.message+' (Drive API 서비스 활성화 여부를 확인하세요.)');}finally{if(id)DriveApp.getFileById(id).setTrashed(true);}}
